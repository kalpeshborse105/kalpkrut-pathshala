# =====================================================================
# Kalpkrut Pathshala ERP - Hostinger Business Plan Production Config
# By Kalpkrut Infotech Pvt Ltd (Ahmedabad, Gujarat)
# =====================================================================

APP_NAME="Kalpkrut Pathshala"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------
# Hostinger MySQL Database Settings
# (Created in Hostinger hPanel -> Databases -> MySQL Databases)
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_kalpkrut_pathshala
DB_USERNAME=u123456789_admin
DB_PASSWORD="your_strong_hostinger_password"

# Session & Cache (Use database driver for reliable persistence)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=kalpkrut_cache_

# ---------------------------------------------------------------------
# Email Configuration (Hostinger Titan Mail / Custom SMTP)
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="Kalpkrut Pathshala"

VITE_APP_NAME="${APP_NAME}"
